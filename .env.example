# Copy this file to .env and replace placeholders with your real values.
# Never commit .env with real keys.

# Your Google Gemini API key (create in Google AI Studio / API keys)
GEMINI_API_KEY=your_api_key_here

# A Gemini model available to your API key. Verify models at:
# https://ai.google.dev/gemini-api/docs/models
# Example: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
